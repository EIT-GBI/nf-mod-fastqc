// Config for the fastqc tests that run the tool for real, rather than checking
// stub wiring.
//
// conf/module.config pins a released tag for this module, but the tests track
// :latest to stay consistent with the other modules here.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: FASTQC_FASTQC {
        container = 'ghcr.io/eit-gbi/nf-mod-fastqc:latest'
        cpus      = 1
    }
}
